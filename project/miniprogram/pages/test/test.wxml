<!--pages/test/test.wxml-->
<view class="page">
  <view class="card">
    <view class="progress-wrap">
      <view class="progress-label">
        <text>第 {{qNum}} / {{totalQ}} 题</text>
        <text class="hint">{{hint}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPct}}%;"></view>
      </view>
    </view>

    <view class="word-card">
      <view class="word-hint">{{qTypeHint}}</view>
      <view class="word {{wordAnim}}">{{word}}</view>
    </view>

    <!-- 认识/不认识 题型 -->
    <view wx:if="{{qtype === 'know'}}" class="buttons">
      <button class="btn btn-secondary btn-lg" bindtap="answer" data-known="0">不认识</button>
      <button class="btn btn-lg" bindtap="answer" data-known="1">认识</button>
    </view>

    <!-- 释义选择 / 近义反义选择 题型 -->
    <view wx:if="{{qtype === 'meaning' || qtype === 'syn'}}" class="meaning-options">
      <button wx:for="{{options}}" wx:key="index"
        class="meaning-option {{item === '不认识' ? 'meaning-unknown' : ''}} {{selectedIdx === index && correctIdx === index ? 'opt-correct' : ''}} {{selectedIdx === index && correctIdx !== index ? 'opt-wrong' : ''}} {{locked && index === correctIdx ? 'opt-correct' : ''}}"
        data-index="{{index}}"
        bindtap="answerMeaning">
        {{item}}
      </button>
    </view>

    <view class="encourage">{{encourage}}</view>
  </view>
</view>
