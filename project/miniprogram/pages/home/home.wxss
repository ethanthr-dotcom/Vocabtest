/* pages/home/home.wxss */
.page { padding: 16rpx 0; }

.hero { text-align: center; padding: 64rpx 32rpx; }
.logo {
  width: 160rpx; height: 160rpx;
  border-radius: 40rpx;
  margin: 0 auto 40rpx;
  display: block;
  background: #F7E9DF;
}
.logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  font-weight: 700;
  color: #C97B5A;
}
.title { font-size: 48rpx; font-weight: 700; color: #3D3530; margin-bottom: 12rpx; }
.subtitle { color: #8B7355; font-size: 30rpx; margin-bottom: 48rpx; }
.home-start { margin: 32rpx 0; }

.home-last {
  margin-top: 48rpx;
  padding: 32rpx;
  background: #F5F1EA;
  border-radius: 40rpx;
  text-align: left;
}
.home-last .label { color: #8B7355; font-size: 24rpx; margin-bottom: 8rpx; }
.home-last .value { font-size: 44rpx; font-weight: 700; color: #C97B5A; }
.home-last .meta { color: #8B7355; font-size: 24rpx; margin-top: 8rpx; }

.features {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}
.feature {
  flex: 1;
  padding: 24rpx 16rpx;
  background: #F5F1EA;
  border-radius: 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.feature .icon { font-size: 44rpx; margin-bottom: 12rpx; }
.feature .text { font-size: 22rpx; color: #8B7355; }

/* 模式选择 */
.mode-select {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 30rpx 0 16rpx;
}
.mode-card {
  padding: 28rpx 28rpx;
  background: #F5F1EA;
  border: 2rpx solid #E8E0D5;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.mode-title {
  font-weight: 700;
  font-size: 30rpx;
  color: #3D3530;
}
.mode-desc {
  font-size: 24rpx;
  color: #8a7563;
  line-height: 1.6;
}
.home-alt {
  text-align: center;
  font-size: 24rpx;
  color: #C97B5A;
  margin-bottom: 10rpx;
}
